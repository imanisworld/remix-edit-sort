  "keyword_rules": [
    {"genre": "Vogue",        "match": ["mq vogue", "vogue", "ballroom", "ha crash", "kiki", "runway", "cunt beat"]},
    {"genre": "Jersey Club",  "match": ["jersey club", "jerseyclub", "jersey"]},
    {"genre": "Atlanta Bass", "match": ["atl bass", "atlanta bass", "atl club", "a-town bounce", "a town bounce", "atl mix", "atlbass"]},
    {"genre": "Miami Bass",   "match": ["miami bass", "booty bass", "bass mix", "booty bounce", "2 live"]},
    {"genre": "Baile Funk",   "match": ["baile funk", "baile", "funk brasil", "brazilian funk", "brasileiro", "montagem", "bregafunk"]},
    {"genre": "Cumbia",       "match": ["cumbia", "guaracha", "cumbiaton"]},
    {"genre": "Juke",         "match": ["footwork", "juke", "teklife", "160 mix"]},
    {"genre": "Ghetto Tech",  "match": ["ghettotech", "ghetto tech", "ghetto house", "detroit booty", "booty tech"]},
    {"genre": "Drum & Bass",  "match": ["drum & bass", "drum and bass", "dnb", "d&b", "liquid dnb", "neurofunk"]},
    {"genre": "Jungle",       "match": ["jungle", "amen break", "ragga jungle"]},
    {"genre": "UKG",          "match": ["ukg", "uk garage", "2step", "2-step", "speed garage", "garage mix", "garage edit", "garage"]},
    {"genre": "Amapiano",     "match": ["amapiano", "piano mix", "log drum"]},
    {"genre": "Afro House",   "match": ["afro house"]},
    {"genre": "Afrobeats",    "match": ["afrobeat", "afrobeats", "afro mix"]},
    {"genre": "Bouyon",       "match": ["bouyon"]},
