{
  "_comment": "Ordered rules. First match wins, so the most specific patterns come first. Genre names match Brooke's existing top-level folders in ~/Downloads/SoundCloud so the new tree merges with the old one instead of forking it.",

  "canonical_genres": [
    "Vogue", "Jersey Club", "Atlanta Bass", "Miami Bass", "Baile Funk", "Cumbia",
    "Juke", "Ghetto Tech", "Jungle", "Drum & Bass", "UKG", "Amapiano", "Afrobeats",
