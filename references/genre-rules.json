    {"genre": "House",        "match": ["musol"]},
    {"genre": "House",        "match": ["house", "tech house", "club house", "nu klub", "chicago house", "kaoz", "disco house", "gospel house"]},
    {"genre": "Hardgroove",   "match": ["hardgroove", "hard groove"]},
    {"genre": "Techno",       "match": ["techno", "schranz", "hard techno", "acid techno"]},
    {"genre": "Electro",      "match": ["electro", "breakbeat", "electro funk"]},
    {"genre": "Disco",        "match": ["disco", "nu disco", "italo"]},
    {"genre": "Latin",        "match": ["reggaeton", "dembow", "perreo", "latin"]},
    {"genre": "Dub",          "match": ["dubplate", "dub mix", "dub version", "dubwise"]},
    {"genre": "R&B",          "match": ["r&b", "rnb", "slow jam", "quiet storm"]},
    {"genre": "Hip-Hop",      "match": ["hip hop", "hip-hop", "trap", "drill", "instru", "boom bap", "phonk"]},
    {"genre": "Soul",         "match": ["soul", "motown", "northern soul"]},
    {"genre": "Funk",         "match": ["funk", "boogie", "p-funk"]},
    {"genre": "Club",         "match": ["club edit", "club mix", "club remix", "club"]},
    {"genre": "Bass",         "match": ["bassline", "bass"]},
    {"genre": "Country",      "match": ["country", "country trap", "country rap", "yeehaw"]}
